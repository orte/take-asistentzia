# Supabase proiektuaren URLa (adib. https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Publishable key berria (sb_publishable_...). EZ erabili inoiz secret key-a
# frontend-ean edo repo-an.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Login pantailak soilik pasahitza eskatzen du; email hau erabiltzen da
# Supabase Auth-en sartzeko (admin erabiltzaile bakarra).
VITE_ADMIN_EMAIL=
